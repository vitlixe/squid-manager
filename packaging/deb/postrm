#!/bin/sh
set -e

case "$1" in
  remove|purge)
    rm -f /etc/squid/conf.d/squid-manager.conf /etc/sudoers.d/squid-manager
    systemctl daemon-reload > /dev/null 2>&1 || true
    systemctl reload squid > /dev/null 2>&1 || true
    ;;
esac

# Purge also deletes the user list, proxy passwords, and panel settings.
if [ "$1" = "purge" ]; then
  rm -rf /opt/squid-manager
  rm -f /etc/squid-manager/squid-manager.env /etc/squid/passwd /etc/squid/passwd.new
  rmdir /etc/squid-manager 2> /dev/null || true
fi
